   "source": [
    "# 工具\n",
    "工具 是 代理（agents） 调用来执行操作的组件。\n",
    "\n",
    "## 创建工具\n",
    "创建工具最简单的方法是使用 @tool 装饰器。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa0002eb",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from langchain.tools import tool\n",
    "\n",
    "@tool\n",
    "def json_dumps(text:str) -> json:\n",
    "    return json.dumps()"
   ]
  }
